rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Skills — public read, admin write
    match /skills/{skillId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'khushalbhandai25@gmail.com';
    }

    // Usernames — public read for availability check, owner-only write
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User profiles — owner read/write
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;

      // Daily challenges subcollection
      match /dailyChallenges/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Question bank subcollection
      match /questionBank/{skillId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Daily challenges — public read
    match /dailyChallenges/{date} {
      allow read: if true;
    }
  }
}
