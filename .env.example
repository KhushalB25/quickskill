# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Admin Panel Secret (set to enable admin access without Firebase custom claims)
# Leave empty to use Firebase admin custom claims instead
VITE_ADMIN_SECRET=

# Admin email — only this email can access the Admin panel
VITE_ADMIN_EMAIL=your_email@example.com

# Firebase Service Account (for seed script - JSON string or path)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# AI API settings for AI-generated questions
# Uses OpenAI-compatible format (works with NVIDIA NIM, MiniMax, OpenAI, etc.)
VITE_AI_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
VITE_AI_API_KEY=your_api_key_here
VITE_AI_MODEL=minimaxai/minimax-m2.7
